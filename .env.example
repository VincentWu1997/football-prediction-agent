# 复制为 .env 后按实际修改。docker compose 会自动读取本文件做变量替换。

# ---- PostgreSQL + pgvector（与 docker-compose.yml 对应）----
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports
POSTGRES_DB=sports
POSTGRES_PORT=5432

# Python 侧 SQLAlchemy 连接串
DATABASE_URL=postgresql+psycopg2://sports:sports@localhost:5432/sports

# ---- Ollama（本机原生安装，不放进 compose）----
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---- 云 GPU vLLM/SGLang（W7 按量租赁时填写）----
# CLOUD_INFERENCE_BASE_URL=http://<云主机IP>:8000/v1
# CLOUD_INFERENCE_API_KEY=EMPTY
